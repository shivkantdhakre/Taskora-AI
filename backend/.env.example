PORT=5050
NODE_ENV=production
CLIENT_URL=https://your-taskora-app.vercel.app

# PostgreSQL Connection String (e.g. Neon, Supabase, Render Postgres)
DATABASE_URL=postgresql://username:password@host/database?sslmode=require

# JWT Configuration
JWT_SECRET=generate_a_secure_random_64_character_secret
JWT_EXPIRES_IN=7d

# Google Gemini AI API Key (from https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash
